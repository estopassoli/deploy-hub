# DeployHub Backend Environment Variables

# Server
PORT=10001
NODE_ENV=production

# Database (SQLite by default)
DATABASE_URL="file:./prisma/deployhub.db"

# JWT Secret - OBRIGATÓRIO. O backend não sobe sem ele.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# Origens permitidas no CORS da API e dos WebSockets (separadas por vírgula).
# Se ficar vazio, a API aceita qualquer origem (comportamento antigo) e o backend avisa
# no boot. Recomendado apontar para o domínio do painel.
# Ex.: CORS_ORIGINS=https://painel.seudominio.com
CORS_ORIGINS=

# Criptografia de App.envVars e Project.envVars em repouso (AES-256-GCM).
# Sem esta variável a criptografia fica desligada e os .env dos apps ficam em texto
# puro dentro do arquivo SQLite. O update.sh gera uma automaticamente se faltar.
# Gere com: openssl rand -hex 32
#
# GUARDE ESTA CHAVE JUNTO COM O BACKUP DO BANCO: sem ela os valores já
# criptografados não são recuperáveis.
ENV_ENCRYPTION_KEY=

# Diretório dos backups automáticos (banco do painel e, opcionalmente, dos apps).
# Fica fora do APPS_DIR de propósito, para não ser varrido pela limpeza de releases.
BACKUP_DIR=/var/backups/deployhub

# Apps directory
APPS_DIR=/root/apps

# Registration Secret - exigido por POST /auth/register.
# Sem esta variável o registro de novas contas fica desabilitado (403), que é o
# comportamento seguro: toda conta deste painel é administradora total do servidor.
# Gere com: openssl rand -hex 16
REGISTRATION_SECRET=

# Faixa de portas reservada aos previews de branch (Fase 6.7).
# Um preview nunca aloca porta fora desta faixa: é o que impede um ambiente efêmero de
# ocupar a porta de um app de produção. Se a faixa lotar, o preview falha com mensagem
# clara em vez de procurar porta em outro lugar.
# PREVIEW_PORT_RANGE=21000-21999

# Email usado pelo certbot ao emitir certificados. Sem isto, o painel usa
# admin@<dominio>, que pode não ser um endereço real — e é para onde vão os avisos de
# certificado prestes a vencer.
# CERTBOT_EMAIL=voce@seudominio.com

# Fallback de transição: aceitar webhooks de apps que não têm segredo configurado.
#
# Por padrão (variável ausente) o webhook de um app sem segredo é RECUSADO com 401, em
# vez de disparar um deploy sem credencial nenhuma. Ligue isto apenas enquanto configura
# os segredos dos apps antigos: enquanto estiver ligado, qualquer um que saiba o nome do
# app dispara deploys. Cada uso é registrado como aviso no log do sistema.
# WEBHOOK_ALLOW_UNSIGNED=true

# Diretório `bin` do Node com que os deploys (install/build) e os apps gerenciados rodam.
#
# Vazio = herda o Node sob o qual o backend roda, que é o comportamento histórico.
# Configure quando o servidor tiver um Node mais novo instalado à parte (nvm) e algum
# projeto exigir uma versão acima da do backend — por exemplo pnpm@11, que pede
# node >=22.13, ou vinext, que usa fs.promises.glob (Node 22+). Sem isto o build falha
# com um erro que não parece ser de versão. Ver "Quando configurar DEPLOY_NODE_BIN" no
# README.
# DEPLOY_NODE_BIN=/root/.nvm/versions/node/v24.11.1/bin
