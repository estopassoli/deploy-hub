# DeployHub Backend Environment Variables

# Server
PORT=10001
NODE_ENV=production

# Database (SQLite by default)
DATABASE_URL="file:./prisma/deployhub.db"

# JWT Secret - OBRIGATÓRIO. O backend não sobe sem ele.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# Origens permitidas no CORS da API e dos WebSockets (separadas por vírgula).
# Se ficar vazio, a API aceita qualquer origem (comportamento antigo) e o backend avisa
# no boot. Recomendado apontar para o domínio do painel.
# Ex.: CORS_ORIGINS=https://painel.seudominio.com
CORS_ORIGINS=

# Apps directory
APPS_DIR=/root/apps

# Registration Secret - exigido por POST /auth/register.
# Sem esta variável o registro de novas contas fica desabilitado (403), que é o
# comportamento seguro: toda conta deste painel é administradora total do servidor.
# Gere com: openssl rand -hex 16
REGISTRATION_SECRET=
