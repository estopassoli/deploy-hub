generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./deployhub.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model App {
  id              String      @id @default(uuid())
  name            String      @unique
  type            String      // nestjs, nextjs, vitejs
  port            Int         @unique
  domain          String?
  repository      String
  branch          String      @default("main")
  status          String      @default("stopped") // running, stopped, error, deploying
  currentPath     String?
  envVars         String?     // Environment variables stored for redeploy
  installCommand  String?     // Custom install command (optional)
  buildCommand    String?     // Custom build command (optional)
  migrateCommand  String?     // Custom migrate command (optional)
  startCommand    String?     // Custom start command (optional)
  appDir           String?   // monorepo target subdir, e.g. "apps/backend"
  workspacePackage String?   // workspace package name, e.g. "@blurp/backend"
  runtime          String    @default("auto") // what the user asked for: auto | pm2 | docker
  activeRuntime    String?   // what actually runs it right now: pm2 | docker | static
  containerPort    Int?      // port inside the container; defaults to the Dockerfile EXPOSE, else `port`
  dockerContext    String?   // build context relative to the repo root; defaults to the repo root
  healthPath       String?   // caminho HTTP checado depois do start; default '/' quando null

  // O que o OPERADOR quer que aconteça: running | stopped.
  //
  // Existe para separar "parei de propósito" de "caiu sozinho". O `status` é o estado
  // real, lido do PM2/Docker/disco a cada leitura — e nele um app parado pelo usuário e
  // um app que crashou aparecem os dois como 'stopped'. Sem essa distinção, o card
  // "Problemas" do Dashboard contava só `status === 'error'` e vivia mostrando 0,
  // mesmo com app caído.
  desiredState     String    @default("running")

  // Limites de recurso (Fase 6.4). Null = sem limite explícito.
  //
  // No PM2 vira `max_memory_restart`; no Docker, `--memory` e `--cpus`. A diferença de
  // semântica é relevante e está documentada em resource-limits.ts: o PM2 REINICIA o
  // processo ao ultrapassar, o Docker MATA o container.
  maxMemoryMb      Int?
  cpuLimit         Float?

  // Monitoramento externo (Fase 6.3). Só faz sentido para app com domínio.
  uptimeEnabled    Boolean   @default(true)
  lastUptimeStatus String?   // up | down
  lastUptimeAt     DateTime?
  sslExpiresAt     DateTime? // notAfter do certificado servido pelo domínio
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deploys         Deploy[]
  metrics         AppMetric[]
  uptimeChecks    UptimeCheck[]
  webhookSecret   String?
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(uuid())
  name           String   @unique
  repository     String
  branch         String   @default("main")
  packageManager String?
  envVars        String?
  currentPath    String?
  status         String   @default("stopped")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  apps           App[]
  deploys        Deploy[]
}

model Deploy {
  id          String   @id @default(uuid())
  appId       String?
  app         App?     @relation(fields: [appId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     String   // timestamp format: 2025-12-06_14-30-22
  commitHash  String?
  commitMessage String?
  path        String   // full path to release
  status      String   @default("pending") // pending, building, success, failed, cancelled
  isCurrent   Boolean  @default(false)
  logs        String?  // Full deploy logs persisted
  startedAt   DateTime? // início efetivo do pipeline
  finishedAt  DateTime? // fim, com sucesso ou não
  phases      String?  // JSON: [{ name, startedAt, finishedAt, durationMs, status }]

  // Release de projeto monorepo -> uma linha filha por service.
  //
  // A linha pai carrega os logs e o isCurrent (é ela que o rollback usa); cada filha
  // tem appId preenchido e projectId nulo, para o card do service conseguir achar o
  // próprio deploy em vez de mostrar "Last deploy: Never" para sempre.
  //
  // Coluna simples, DE PROPÓSITO, sem `@relation` para o próprio Deploy. Uma FK de
  // auto-relação não pode ser adicionada por ALTER TABLE no SQLite: o Prisma resolveria
  // com DROP TABLE + recriação + INSERT...SELECT. Os dados seriam copiados, mas dropar
  // a tabela de histórico (com todos os logs de deploy) de um banco de produção é risco
  // que esta feature não justifica. Sem a FK, a limpeza das filhas é feita em código.
  parentId    String?

  createdAt   DateTime @default(now())

  @@index([appId, createdAt])
  @@index([projectId, createdAt])
  @@index([parentId])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // info, warn, error, debug
  message   String
  source    String?
  appId     String?
  createdAt DateTime @default(now())
}

// Resultado de uma checagem HTTP externa do domínio de um app.
//
// Diferente do health check do deploy, que bate em 127.0.0.1: aqui a requisição passa
// por DNS, nginx e TLS, que é o caminho que o usuário final percorre. Um app pode estar
// perfeitamente vivo no PM2 e mesmo assim inacessível — certificado vencido, vhost
// apagado, DNS mudado.
model UptimeCheck {
  id         String   @id @default(uuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  status     String   // up | down
  statusCode Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime @default(now())

  @@index([appId, checkedAt])
}

model AppMetric {
  id        String   @id @default(uuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  cpu       Float    @default(0)
  memory    Float    @default(0)
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
}

// Trilha de auditoria: quem fez o quê, quando e de onde.
//
// Guarda apenas metadados. Valores de variáveis de ambiente, tokens e webhooks NUNCA
// entram aqui — só os NOMES das chaves alteradas. Um log de auditoria que guarda
// segredos vira, ele mesmo, o alvo mais valioso do sistema.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String   // deploy.create, app.delete, env.update, terminal.open, ...
  targetType String?  // app | project | system | terminal
  targetId   String?
  targetName String?
  metadata   String?  // JSON já redigido
  ip         String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetId, createdAt])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model SystemSettings {
  id              String   @id @default(uuid())
  emailEnabled    Boolean  @default(false)
  emailRecipient  String?

  // Canais de notificação. `slackWebhook` já existia na tabela desde a primeira
  // migration e nunca foi usado por nada — havia um campo na UI que não salvava e
  // nenhum código que enviasse. Agora os quatro canais são de verdade.
  slackWebhook    String?
  discordWebhook  String?
  telegramBotToken String?
  telegramChatId  String?

  // Quais eventos disparam notificação. Default: os três que exigem ação humana.
  notifyDeployFailed   Boolean @default(true)
  notifyDeploySuccess  Boolean @default(false)
  notifyRollback       Boolean @default(true)
  notifyAppDown        Boolean @default(true)
  notifySslExpiring    Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
